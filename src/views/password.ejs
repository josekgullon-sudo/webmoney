<%- include('partials/header') %>
<section class="card narrow">
  <h1>Cambiar contrasena</h1>
  <% if (forced) { %>
    <p class="alert warn">Estas usando la contrasena provisional. Elige una nueva para continuar.</p>
  <% } %>
  <% if (error) { %><p class="alert error"><%= error %></p><% } %>
  <% if (ok) { %><p class="alert ok">Contrasena actualizada. <a href="/panel">Ir al panel</a></p><% } %>
  <form method="post" action="/password">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Contrasena actual
      <input name="current" type="password" required autocomplete="current-password">
    </label>
    <label>Nueva contrasena (minimo 10 caracteres)
      <input name="password" type="password" required minlength="10" autocomplete="new-password">
    </label>
    <label>Repite la nueva contrasena
      <input name="repeat" type="password" required minlength="10" autocomplete="new-password">
    </label>
    <button type="submit" class="btn primary">Guardar</button>
  </form>
</section>
<%- include('partials/footer') %>
