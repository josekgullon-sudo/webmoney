# ─── Panel ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
# URL publica del panel (la que uses en DuckDNS)
APP_URL=https://TU-SUBDOMINIO.duckdns.org
# Obligatorio en produccion. Genera uno con: openssl rand -hex 32
SESSION_SECRET=
# Ponlo a true si el panel esta detras de Caddy / nginx (es lo normal)
TRUST_PROXY=true
SESSION_TTL_HOURS=12
DB_PATH=./data/panel.db
PLATFORM_CURRENCY=EUR
# Comision por defecto que se queda la plataforma (%). Se puede ajustar por usuario.
DEFAULT_FEE_PCT=0

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Panel de Stripe > Desarrolladores > Claves de API
STRIPE_SECRET_KEY=sk_live_xxx
# Panel de Stripe > Desarrolladores > Webhooks > https://TU-SUBDOMINIO.duckdns.org/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ─── Telegram ─────────────────────────────────────────────────────────────────
# Token que da @BotFather al crear el bot
TELEGRAM_BOT_TOKEN=
# Tu chat ID personal (escribe a @userinfobot para saberlo)
TELEGRAM_ADMIN_CHAT_ID=

# ─── Kraken ───────────────────────────────────────────────────────────────────
# API key con permisos: consultar saldo, crear ordenes y retirar fondos
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
# simulate = registra los pagos sin mover dinero real (empieza siempre asi)
# live     = ejecuta ordenes y retiradas de verdad
KRAKEN_MODE=simulate
# true: compra la cripto con el saldo EUR antes de retirar
# false: ya tienes la cripto en Kraken y solo se retira
KRAKEN_TRADE_BEFORE_WITHDRAW=true

# ─── Pagos automaticos ────────────────────────────────────────────────────────
PAYOUT_AUTO=true
# Cada dia a las 23:30
PAYOUT_CRON=30 23 * * *
PAYOUT_TIMEZONE=Europe/Madrid
# Importe minimo (en la moneda del panel) para lanzar un envio
PAYOUT_MIN_AMOUNT=25

LOG_LEVEL=info
